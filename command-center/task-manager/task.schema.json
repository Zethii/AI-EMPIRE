{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-empire.local/schemas/task.schema.json",
  "title": "AI-EMPIRE Task",
  "type": "object",
  "required": ["task_id", "title", "status", "created_at"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"type": "string", "enum": ["REQUESTED", "PLANNED", "APPROVAL", "ASSIGNED", "RUNNING", "REVIEW", "REVISION", "VERIFIED", "DELIVERED", "BLOCKED", "FAILED", "CANCELLED"]},
    "priority": {"type": "string", "enum": ["low", "normal", "high", "urgent"], "default": "normal"},
    "assigned_agents": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "approval_required": {"type": "boolean", "default": false},
    "approval_status": {"type": "string", "enum": ["not_required", "pending", "approved", "rejected"]},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
